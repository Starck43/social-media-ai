# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc

# Project
# NOTE: /migrations/ used to be ignored here. Alembic revisions are the only
# source of the DB schema, so they must be tracked — a fresh clone/VPS deploy
# would otherwise create an empty database.
build/
dist/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing
.coverage
.coverage.*
.cache
coverage.xml
.pytest_cache/
htmlcov/

# Database
*.db
db.sqlite3
db.sqlite3*

# Environment
.env*
!.env.example
.venv/
venv/
ENV/

# IDEs and Editors
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Logs
logs/
*.log

# Agent workspace is local-only except shared development rules.
.agent/*
!.agent/rules.md
!.agent/tasks.md
!.agent/state.json
!.agent/workflow.md
!.agent/todo.md
!.agent/index.md
!.agent/lessons/
!.agent/test-task.md
!.agent/test-report.md
.gigacode/
# Kilo: allow traversal so agent config (agents, skills, IDE links) can be
# tracked; ignore generated/runtime state inside.
!.kilo/
.kilo/*
!.kilo/agents/
!.kilo/skills/
!.kilo/.gitignore

# Backup artifacts
*.backup
backups/
*.dump

