# Copy to .env.staging and replace EVERY placeholder before starting the stack.
# These are staging-only values; never copy production secrets into this file.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-new-64-byte-token-url-safe-secret
CREDENTIALS_KEY=replace-with-a-new-staging-only-fernet-key
BACKEND_CORS_ORIGINS=["http://localhost:18000"]

POSTGRES_USER=staging
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters
POSTGRES_DB=social_ai_staging
POSTGRES_URL=postgresql+asyncpg://staging:replace-with-the-same-hex-password@db:5432/social_ai_staging
DB_SCHEMA=public
DB_POOL=pool

# The API-only stack does not start app.runtime; keep scheduling disabled.
SCHEDULER_ENABLED=false
