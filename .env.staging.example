# Copy to .env.staging; replace placeholders with unique staging-only values.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-new-64-byte-token-url-safe-secret
CREDENTIALS_KEY=replace-with-a-new-staging-only-fernet-key
BACKEND_CORS_ORIGINS=[]

POSTGRES_USER=staging
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters
POSTGRES_DB=social_ai_staging
# URL: scheme postgresql+asyncpg, host db, port 5432, user staging, database social_ai_staging.
# Use the same generated POSTGRES_PASSWORD; do not copy another environment URL.
POSTGRES_URL=replace-with-a-staging-database-url
DB_SCHEMA=public
DB_POOL=pool
REDIS_URL=redis://redis:6379/0
DOCKER_SUBNET=172.30.43.0/24
NGINX_CONTAINER_IP=172.30.43.2

# Staging does not start app.runtime; jobs/schedules/listeners remain off.
SCHEDULER_ENABLED=false
DATA_RETENTION_MONTHS=1
