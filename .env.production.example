# Copy to .env.production and chmod 600. Never commit the real file.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=replace-with-a-new-64-byte-token-url-safe-secret
CREDENTIALS_KEY=replace-with-a-stable-production-fernet-key
BACKEND_CORS_ORIGINS=[]
ADMIN_ENABLED=true

POSTGRES_USER=social_ai
POSTGRES_PASSWORD=replace-with-64-lowercase-hex-characters
POSTGRES_DB=social_ai
# URL: scheme postgresql+asyncpg, host db, port 5432, user social_ai, database social_ai.
# Use the same generated POSTGRES_PASSWORD; do not copy another environment URL.
POSTGRES_URL=replace-with-a-production-database-url
DB_SCHEMA=public
DB_POOL=pool
REDIS_URL=redis://redis:6379/0
DOCKER_SUBNET=172.30.42.0/24
NGINX_CONTAINER_IP=172.30.42.2

# Runtime is an explicit Compose profile and stays stopped until approved.
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
DATA_RETENTION_MONTHS=1
# P6-T01: retention is irreversible; keep runtime off until backup and rollout approval.
LOG_LEVEL=INFO
