# Database (required)
POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=social_ai
POSTGRES_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/social_ai

# Schema the pytest suite works in (optional — defaults to `test_schema`). It is
# published to the app as DB_SCHEMA, so tests never read or write the working
# schema. This is the only isolation the suite needs.
# Note: models and new migrations read DB_SCHEMA. When running
# `alembic check`/`alembic revision --autogenerate`, make sure DB_SCHEMA points
# at the schema you are diffing against (default `public`), otherwise alembic
# reports spurious drops because the model metadata and the live tables are in
# different schemas.
# DB_TEST_SCHEMA=test_schema

# Database for the pytest suite (optional — defaults to the working one). A
# separate database adds a second level of isolation but needs the CREATEDB
# privilege; with it set, the suite creates and seeds that database on first run.
# TEST_POSTGRES_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/social_ai_test

# Redis (optional — only needed by frozen Celery / sqladmin storage)
REDIS_URL=redis://redis:6379/0

# JWT Configuration (required)
SECRET_KEY=your_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VK API (optional — VK integration disabled when empty)
# App credentials — one VK app per deployment. Personal L2 token lives in the
# user vault (`python -m cli.main credentials oauth vk --user <id>`).
VK_APP_ID=
VK_SERVICE_KEY=             # VK "Сервисный ключ доступа" (L1)
VK_CLIENT_ACCESS_KEY=       # VK "Защищённый ключ" (OAuth client secret)

# Telegram (optional — Telegram channel disabled when token is empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to talk to the agent
TELEGRAM_OWNER_IDS=
# Target channel/chat id for scheduled digests (e.g. @mychannel or -1001234567890)
TELEGRAM_DIGEST_CHANNEL_ID=
# L2 MTProto collection (optional). Preferred: user vault via
# `python -m cli.main credentials login telegram --user <id>`; these env vars are
# an env-only fallback. The session string is a full-access
# credential — never commit or log it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# MAX messenger (optional — MAX channel disabled when token is empty)
# Bot API docs: https://dev.max.ru
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api2.max.ru
MAX_OWNER_ID=
MAX_CHANNEL_ID=

# Scheduler
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=30
SCHEDULER_TIMEZONE=Europe/Moscow

# Agent
AGENT_MODEL=
AGENT_HISTORY_LIMIT=20
AGENT_MAX_ITERATIONS=6
AGENT_DAILY_COST_LIMIT=5.0  # USD cap per UTC day: agent chat + digest summaries

# Background jobs
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BACKOFF_SECONDS=300

LOG_LEVEL=INFO

# Application Settings
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:8000

# LLM providers
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Celery (frozen — kept for backward compatibility)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Tenancy (shared bot: clients bind their chats to workspaces) ---
# slug of the bootstrap workspace that owns pre-existing data
DEFAULT_TENANT_SLUG=owner
# Fernet key for user_credentials (personal L2 secrets) AND LLM provider keys.
# REQUIRED when saving
# encrypted_api_key in the LLM admin.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

