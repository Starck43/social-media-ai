# Database (required). The application reads only POSTGRES_URL.
POSTGRES_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/social_ai

# Compose-only: the `db` service of docker/docker-compose.yml reads these to
# initialise the container. The application never reads them, so a local run
# against an existing database can leave them empty. Keep POSTGRES_PASSWORD in
# sync with the password inside POSTGRES_URL above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=social_ai

# Schema the pytest suite works in (optional — defaults to `test_schema`). It is
# published to the app as DB_SCHEMA, so tests never read or write the working
# schema. This is the only isolation the suite needs.
# Note: models and new migrations read DB_SCHEMA. When running
# `alembic check`/`alembic revision --autogenerate`, make sure DB_SCHEMA points
# at the schema you are diffing against (default `public`), otherwise alembic
# reports spurious drops because the model metadata and the live tables are in
# different schemas.
# DB_TEST_SCHEMA=test_schema

# Database for the pytest suite (optional — defaults to the working one). A
# separate database adds a second level of isolation but needs the CREATEDB
# privilege; with it set, the suite creates and seeds that database on first run.
# TEST_POSTGRES_URL=postgresql+asyncpg://postgres:your_secure_password_here@db:5432/social_ai_test

# Async engine connection reuse (optional). `null` opens a new connection per
# session instead of pooling. A pooled asyncpg connection belongs to the event
# loop that opened it, so a process that runs parts of its work in another
# loop (the test suite runs several unittest-style cases in a loop of their
# own) must not reuse connections. The suite sets this itself.
# DB_POOL=pool

# Redis (optional — only needed by frozen Celery / sqladmin storage)
REDIS_URL=redis://redis:6379/0

# JWT Configuration (required)
SECRET_KEY=your_secret_key_here
# Set the externally reachable HTTP(S) host before scheduling greetings/campaigns.
PUBLIC_BASE_URL=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# VK API (optional — VK integration disabled when empty)
# App credentials — one VK app per deployment. Personal L2 token lives in the
# user vault (`python -m cli.main credentials oauth vk --user <id>`).
VK_APP_ID=
VK_SERVICE_KEY=             # VK "Сервисный ключ доступа" (L1)
VK_CLIENT_ACCESS_KEY=       # VK "Защищённый ключ" (OAuth client secret)

# Telegram (optional — Telegram channel disabled when token is empty)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Comma-separated Telegram user ids allowed to talk to the agent
TELEGRAM_OWNER_IDS=
# Target channel/chat id for scheduled digests (e.g. @mychannel or -1001234567890)
TELEGRAM_DIGEST_CHANNEL_ID=
# L2 MTProto collection (optional). Preferred: user vault via
# `python -m cli.main credentials login telegram --user <id>`; these env vars are
# an env-only fallback. The session string is a full-access
# credential — never commit or log it.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# MAX messenger (optional — MAX channel disabled when token is empty)
# Bot API docs: https://dev.max.ru
MAX_BOT_TOKEN=
# Provider API host read by `app/channels/max.py`; override only for a reviewed proxy.
MAX_API_URL=https://platform-api2.max.ru
MAX_OWNER_ID=
MAX_CHANNEL_ID=

# Workspace subscription payments (P2-T16 foundation, not a working checkout).
# YooKassa is the default Russian payment provider. Selecting it is not consent
# to create payments. Keep disabled until P2-T15/0117 and subscription persistence,
# verification and acceptance gates are integrated and explicitly authorized.
# Personal budget admission. Off means per-user paid usage is refused outright,
# regardless of the YooKassa settings below.
PERSONAL_BILLING_ENABLED=false
SUBSCRIPTION_PAYMENT_PROVIDER=yookassa
SUBSCRIPTION_PAYMENT_MODE=test
SUBSCRIPTION_CHECKOUT_ENABLED=false
# Use ONLY the test store's ID and secret from the YooKassa Merchant Profile.
# Never paste a live merchant key here; never commit actual credentials.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Fixed server-configured browser return URL, e.g. an approved HTTPS settings URL.
# This redirect is NOT payment proof. No arbitrary user-supplied return URLs.
YOOKASSA_RETURN_URL=
YOOKASSA_HTTP_TIMEOUT=15
# Both test/live stores use https://api.yookassa.ru/v3; there is no test API host.
# HTTP Basic notifications are configured in the Merchant Profile, not with an
# invented webhook signing secret. The webhook route is not implemented yet.
# Test mode alone does not verify the shop: authenticated payment retrieval must
# confirm test=true, the merchant, amount/currency and the stored purchase binding.

# Scheduler / runtime — read by `python -m app.runtime` only; a bare `uvicorn`
# serves the API with no scheduler at all. Poll interval, job retry counts and
# the staleness window are tuning defaults listed in docs/CONFIGURATION.md.
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Europe/Moscow
# Opt-in same-host runtime presence. API and runtime must share this absolute
# local directory; never point it at a network filesystem.
# RUNTIME_STATE_DIR=/var/lib/social-media-ai/runtime

# Agent
# Exact name of an active LLM catalog row (SQLAdmin → LLM models), resolved
# inside the acting user's personal catalog. Empty = automatic selection; an
# unknown name logs a fallback instead of failing.
AGENT_MODEL=
# Hard daily USD cap across agent chat and digest summaries.
AGENT_DAILY_COST_LIMIT=5.0

# Data retention (calendar months, minimum 1). The daily prune deletes analysis
# results and unanalysed raw content older than this; deletion is irreversible.
DATA_RETENTION_MONTHS=1

LOG_LEVEL=INFO

# Application Settings
DEBUG=false
ENVIRONMENT=production
ALLOWED_ORIGINS=http://localhost:8000

# --- Tenancy (shared bot: clients bind their chats to workspaces) ---
# slug of the bootstrap workspace that owns pre-existing data
DEFAULT_TENANT_SLUG=owner
# Fernet key for user_credentials (personal L2 secrets) AND LLM provider keys.
# REQUIRED when saving
# encrypted_api_key in the LLM admin.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_KEY=

# P13-T02 personal data (owner decision D8): separate keys, never CREDENTIALS_KEY.
# First encryption key is active; keep older keys after it while rotating.
# PII_ENCRYPTION_KEYS: comma-separated Fernet keys (same generator as above).
# PII_INDEX_KEY: urlsafe-base64 >= 32 bytes, kept stable (not rotated).
# Contract and rotation: docs/PII_PROTECTION.md
PII_ENCRYPTION_KEYS=
PII_INDEX_KEY=


# P9-T01: one manually approved Telegram channel message, OFF by default.
# Both switches are required; exact workspace_id:tenant_channel_id pairs only.
# Production enablement needs an explicit owner rollout choice (docs/ACTION_ACTIVATION.md).
P9_TELEGRAM_MESSAGE_ENABLED=0
P9_TELEGRAM_MESSAGE_BINDINGS=

# P12-T12: saved personal cloud metadata UI only; no provider refresh/open/download.
# Keep off until the branch catalog schema is applied to the intended local DB.
FILE_CATALOG_UI_ENABLED=0

# Exact trusted VK OAuth endpoint hosts; add a reviewed proxy explicitly.
VK_OAUTH_ALLOWED_HOSTS=id.vk.ru

# P12-T12: bounded file read/preview and private-consent controls; requires 0128.
# This enables no provider writes and supplies no immutable-version authority.
FILE_WORKSPACE_ACTIONS_ENABLED=0
